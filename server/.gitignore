# ==========================================
# Python & Compilation
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# Environments & uv Package Manager
# ==========================================
.venv/
venv/
ENV/
env/
.env
.venv*
# Keep uv.lock as it preserves exact package versions for your team
!uv.lock

# ==========================================
# E-commerce Media, File Uploads, & Static
# ==========================================
# Stores product images, user avatars, invoices, receipts, etc.
/media/
# Collected frontend files (CSS, JS) from running collectstatic
/static/
/staticfiles/

# ==========================================
# Security & Secret Management
# ==========================================
# Never commit credentials, payment keys (Stripe/PayPal), or Django secret keys
.env
.env.*
!.env.example
*.env
secrets.json
*.pem
*.key

# ==========================================
# Databases & Local Search Indexing
# ==========================================
# Standard SQLite files (if used for local testing)
*.sqlite3
*.db
# Elasticsearch or cache dumps if running local engines
.elastic/
celerybeat-schedule

# ==========================================
# Build, Distribution, and IDEs
# ==========================================
# Build outputs
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Editor configs (VS Code, PyCharm, Cursor)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store

# ==========================================
# Logs & Testing
# ==========================================
# Payment processing gateway logs, webhook testing payloads, general execution bugs
*.log
local_settings.py
.pytest_cache/
.coverage
htmlcov/
.tox/
